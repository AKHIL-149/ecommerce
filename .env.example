# EcomAnalytics Environment Configuration
# Copy this file to .env and update with your values

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3001

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL Connection
POSTGRES_DB=ecom_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/ecom_analytics

# ===========================================
# CACHE
# ===========================================
# Redis Connection
REDIS_URL=redis://redis:6379

# ===========================================
# SECURITY
# ===========================================
# JWT Secret - MUST be changed in production
# Generate with: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars

# JWT Expiration (e.g., 7d, 24h, 60m)
JWT_EXPIRATION=7d

# Bcrypt Salt Rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# ===========================================
# FRONTEND
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# RATE LIMITING
# ===========================================
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window (default: 1000)
RATE_LIMIT_MAX_REQUESTS=1000

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins (optional)
# Example: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=

# ===========================================
# E-COMMERCE PLATFORM CONNECTORS
# ===========================================
# These are set per-store in the database, not globally
# Example format for reference:

# Shopify
# SHOPIFY_SHOP_URL=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=your_access_token

# WooCommerce
# WOOCOMMERCE_URL=https://your-store.com
# WOOCOMMERCE_CONSUMER_KEY=ck_xxxx
# WOOCOMMERCE_CONSUMER_SECRET=cs_xxxx

# ===========================================
# LOGGING
# ===========================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===========================================
# CACHE TTL (in seconds)
# ===========================================
CACHE_TTL_SALES=3600
CACHE_TTL_PRODUCTS=1800
CACHE_TTL_CUSTOMERS=1800

# ===========================================
# DATABASE POOL CONFIGURATION
# ===========================================
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ===========================================
# EMAIL (Optional - for future features)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@ecomanalytics.com

# ===========================================
# MONITORING (Optional)
# ===========================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# ENABLE_METRICS=false
